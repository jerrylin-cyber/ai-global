{
  "identifier": "com.lazyjerry.tauri-gui",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
