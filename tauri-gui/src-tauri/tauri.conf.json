{
  "productName": "ai-global",
  "version": "2.4.0",
  "identifier": "com.lazyjerry.tauri-gui",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:8001",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "minHeight": 750,
        "minWidth": 750,
        "resizable": true,
        "title": "AI-GLOBAL",
        "width": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
